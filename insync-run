#!/bin/bash 

export QT_XCB_GL_INTEGRATION=none 
[ -n "$DEBUG" ] && set -x

case $INSYNC_CMD in
    start)
        INSYNC_CMD=show $0 &
        insync start --no-daemon 
    ;;
    show)
        while ! [ -e "/tmp/insync$(id -u).sock" ] ; do
            sleep 1
        done
        sleep 1
        insync show
    ;;
    *)
        echo
        echo "Starting Insync $(insync version)"
        echo
        INSYNC_CMD=start xvfb-cmd $0 
    ;;
esac

exit
