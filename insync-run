#!/bin/bash

export QT_XCB_GL_INTEGRATION=none 

case $INSYNC_CMD in
    1)
        echo "---> 1" >>/tmp/insync.log
        xterm -hold -e "INSYNC_CMD=2 $0" &
        xterm -e "insync start --no-daemon 2>&1 | tee -a /tmp/insync.log"
        kill $(cat /tmp/insync.pid) 
    ;;
    2)
        echo "---> 2" >>/tmp/insync.log
        while ! [ -e "/tmp/insync1.sock" ] ; do
            sleep 1
        done
        sleep 1
        insync show
    ;;
    *)
        rm -f /tmp/insync.pid
        >/tmp/insync.log
        echo $$ >/tmp/insync.pid
        INSYNC_CMD=1 xvfb-cmd $0 &
        tail -f /tmp/insync.log
    ;;
esac

exit
